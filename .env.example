# GoLogin Configuration (BẮT BUỘC)
GOLOGIN_TOKEN=your_gologin_api_token_here

# Optional: Use existing profile ID
GOLOGIN_PROFILE_ID=

# Proxy Configuration (Khuyến nghị)
PROXY_ENABLED=false
PROXY_HOST=your-proxy.com
PROXY_PORT=8080
PROXY_USER=username
PROXY_PASS=password

# Browser Settings
HEADLESS=false
BROWSER_TIMEOUT=30000
PAGE_LOAD_TIMEOUT=60000

# Logging
LOG_LEVEL=INFO
